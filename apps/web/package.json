{
  "name": "@careerforge/web",
  "version": "0.1.0",
  "private": true,
  "description": "CareerForge AI web client — Next.js 15 App Router, Tailwind v4, evidence-first UI.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:api": "node --experimental-strip-types scripts/smoke-live-api.mts",
    "capture:pages": "node --experimental-strip-types scripts/capture-pages.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "capture:gif": "playwright test demo-capture.spec.ts --project=desktop"
  },
  "dependencies": {
    "@careerforge/shared": "workspace:*",
    "@careerforge/ui": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-query": "^5.103.2",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@careerforge/config": "workspace:*",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.26",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
