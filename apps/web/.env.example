# CareerForge AI — web client environment
# Copy to `apps/web/.env.local` (never commit a real .env file).

# Base URL of the FastAPI backend (docs/API.md § "Base URL").
# When the backend is not running, the UI reports "Backend not reachable" with this
# exact URL instead of rendering fabricated data.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
