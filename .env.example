# ─────────────────────────────────────────────────────────────
# CareerForge AI — environment template
# Copy to .env and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
APP_NAME=CareerForge AI
APP_VERSION=0.1.0
ENVIRONMENT=development            # development | test | production
DEBUG=true
LOG_LEVEL=INFO
GIT_SHA=                           # injected by CI / docker build

# ── Security ──────────────────────────────────────────────────
# MUST be overridden outside development. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
# postgres+pgvector (production / docker compose)
DATABASE_URL=postgresql+asyncpg://careerforge:careerforge@localhost:5432/careerforge
# Set to true to use the zero-dependency SQLite path (no Docker required)
USE_SQLITE=false
SQLITE_PATH=./data/careerforge.db

# ── Vector store ──────────────────────────────────────────────
# pgvector | sqlite (auto-selected from USE_SQLITE when unset)
VECTOR_BACKEND=pgvector
EMBEDDING_DIM=1536
VECTOR_TOP_K=8
RRF_K=60

# ── Queue ─────────────────────────────────────────────────────
# redis | inprocess (auto-selected from USE_SQLITE when unset)
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# ── File storage ──────────────────────────────────────────────
# `local` is the only implemented backend. `s3` is accepted by the settings model but
# rejected at startup until PHASE 15, so a misconfiguration fails loudly instead of
# silently spooling to disk.
STORAGE_BACKEND=local              # local | s3 (s3 not implemented yet)
# Spool directory: an upload waits here between the 202 that accepted it and the worker
# that parses it. The file is deleted as soon as the parse finishes.
STORAGE_LOCAL_PATH=./data/uploads
# Deployment upload limit in MiB. The effective limit is the lower of this and the AI
# core's own 20 MiB ceiling.
MAX_UPLOAD_MB=10
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── LLM providers ─────────────────────────────────────────────
# Provider chain. `heuristic` is always available and requires no key.
# Options: deepseek | openai | ollama | heuristic
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=heuristic

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai          # openai | deepseek | ollama | heuristic
EMBEDDING_MODEL=text-embedding-3-small

# ── Model routing (cost control) ──────────────────────────────
# cheap model for extraction/classification, strong model for generation/interview
ROUTE_EXTRACTION_MODEL=deepseek-chat
ROUTE_GENERATION_MODEL=deepseek-chat
ROUTE_INTERVIEW_MODEL=deepseek-chat

# ── AI cost guardrails ────────────────────────────────────────
AI_DAILY_BUDGET_USD=1.00           # per user, per day
AI_MAX_TOKENS_PER_CALL=4096
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
CACHE_TTL_LLM_SECONDS=86400
CACHE_TTL_EMBEDDING_SECONDS=604800

# ── GitHub ────────────────────────────────────────────────────
# Optional. Without a token the app uses the anonymous API with backoff
# and falls back to bundled offline snapshots.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=21600

# ── Scoring weights (must sum to 1.0) ─────────────────────────
MATCH_WEIGHT_SKILL=0.40
MATCH_WEIGHT_EXPERIENCE=0.25
MATCH_WEIGHT_PROJECT=0.20
MATCH_WEIGHT_EDUCATION=0.05
MATCH_WEIGHT_EVIDENCE=0.10

# ── Evidence confidence thresholds ────────────────────────────
CLAIM_SUPPORTED_THRESHOLD=0.75
CLAIM_PARTIAL_THRESHOLD=0.45
CLAIM_MIN_SOURCES=2

# ── Rate limiting ─────────────────────────────────────────────
# Budgets from docs/API.md §1.7. The values below are the shipped defaults.
# The AI budget counts the requests that can spend model tokens (POST/PUT/PATCH on an AI path);
# a GET on the same path is a read and is charged to RATE_LIMIT_READ_PER_MIN.
RATE_LIMIT_READ_PER_MIN=300
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=10
# Uploads and document analysis share this hourly bucket. Raise it for a deployment that ingests
# more than twenty documents an hour (a bulk import), or for a browser-test stack — see
# `apps/web/e2e/README.md`, which is where the E2E budgets are declared.
RATE_LIMIT_UPLOAD_PER_HOUR=20

# ── Frontend (apps/web) ───────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=CareerForge AI
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# ── Demo seed ─────────────────────────────────────────────────
DEMO_USER_EMAIL=demo@careerforge.ai
DEMO_USER_NAME=Alex Chen
DEMO_USER_SLUG=alex
