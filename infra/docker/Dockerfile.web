# Next.js frontend image.
#
# Built from the repository root, because the web app depends on workspace
# packages (`@careerforge/ui`, `@careerforge/shared`, `@careerforge/config`).
#   docker build -f infra/docker/Dockerfile.web -t careerforge-web .

# 鈹€鈹€ Stage 1: dependencies 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /repo

# Copy only what the lockfile resolution needs, so this layer caches well.
#
# `pnpm-lock.yaml` is part of "what the lockfile resolution needs" — omitting it made this stage fail
# with `ERR_PNPM_NO_LOCKFILE: Cannot install with "frozen-lockfile" because pnpm-lock.yaml is absent`,
# which is a build that could never have succeeded. CI's `images` job found it the first time the
# image was actually built anywhere.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile

# 鈹€鈹€ Stage 2: build 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /repo

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/apps/web/node_modules ./apps/web/node_modules
# Both of these, in this order, and the order is the point.
#
# `--from=deps` brings the workspace packages' *installed* `node_modules` (the links pnpm created), but
# that stage only ever had their `package.json` files — so on its own the builder had no source for
# `@careerforge/ui`, `@careerforge/shared` or `@careerforge/config`. `next build` then failed with
# `TS6053: File '@careerforge/config/tsconfig/nextjs.json' not found`, which is `apps/web/tsconfig.json`
# extending a preset that was never copied. The context copy below overlays the real source on top.
COPY --from=deps /repo/packages ./packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm --filter @careerforge/web build

# 鈹€鈹€ Stage 3: runtime 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Standalone output keeps the image small; it is enabled in next.config.ts.
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

# The container has no shell tools beyond busybox, so the healthcheck uses node.
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
