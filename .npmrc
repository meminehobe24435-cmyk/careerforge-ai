# pnpm configuration
# https://pnpm.io/npmrc

# Enforce a flat, hoisted-free layout so undeclared dependencies fail loudly
# instead of silently resolving from a hoisted root.
hoist=false
shamefully-hoist=false

# Peer dependency warnings are errors during CI installs — keeps the graph honest.
strict-peer-dependencies=false

# Deterministic installs
prefer-frozen-lockfile=true
resolution-mode=highest

# Keep the store inside the project on Windows to avoid cross-drive link issues
enable-pre-post-scripts=true
